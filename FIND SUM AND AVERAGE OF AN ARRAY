#include <stdio.h>

int main() {
    int n, i;
    float sum = 0, avg;
    
    printf("Enter size of array: ");
    scanf("%d", &n);
    
    int arr[n];
    printf("Enter %d elements: ", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        sum += arr[i];  
    }
    
    avg = sum / n;
    
    printf("\nSum of array = %.2f\n", sum);
    printf("Average of array = %.2f\n", avg);
    
    return 0;
}
