#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char str[1000];
    int alpha = 0, digit = 0, special = 0;
    int i;
    
    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);
    
    
    int len = strlen(str);
    if (str[len-1] == '\n') {
        str[len-1] = '\0';
    }
    

    for (i = 0; str[i] != '\0'; i++) {
        if (isalpha(str[i])) {
            alpha++;
        }
        else if (isdigit(str[i])) {
            digit++;
        }
        else if (str[i] != ' ' && str[i] != '\t') {  
            special++;
        }
    }
    
    printf("\nResults:\n");
    printf("Alphabets: %d\n", alpha);
    printf("Digits: %d\n", digit);
    printf("Special symbols: %d\n", special);
    printf("Total characters: %d\n", alpha + digit + special);
    
    return 0;
}

