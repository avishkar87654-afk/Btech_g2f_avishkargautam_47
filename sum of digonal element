#include<stdio.h>
int main()
{
    int A[10][10],i,j,r,c,s=0;
    printf("row size=");
    scanf("%d",&r);
    printf("column size=");
    scanf("%d",&c);
    if(r!=c)
    {
        printf("sum not possible");
    }
    else{
        printf("enter the element in matrix=");
        for(i=0;j<c;j++)
        {
            scanf("%d",&A[i][j]);
            printf("sum of diagonal elements");
            for(i=0;i<r;i++)
            {
                for(j=0;j<c;j++)
                {
                    if(i==j|i+j==(r-1))
                    {
                        s=s+A[i][j];
                    }
                }
            }
            
        }
        printf("%d",s);
    }
    return 0;
}
